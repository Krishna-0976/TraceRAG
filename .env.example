# =============================================================================
# TraceRAG Environment Variables
# =============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL + pgvector for Docker / production)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/tracerag
# Alternatively, for zero-config local development without PostgreSQL daemon:
# DATABASE_URL=sqlite:///./tracerag.db

# OpenAI API Settings
# If left empty, TraceRAG automatically runs in high-fidelity deterministic Demo Mode
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model Configurations
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
EVAL_JUDGE_MODEL=gpt-4o-mini

# Default Ingestion & Retrieval Hyperparameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.40
